{
    "name": "Doomscroll Valley",
    "description": "A clicker game where you scroll instead of click",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup.html",
        "default_icon": "images/temporary.png"
    },
    "content_scripts": [
        {
            "js": ["content.js"],
            "matches": [
                "https://www.instagram.com/reels/*",
                "https://developer.chrome.com/docs/extensions/*",
                "https://developer.chrome.com/docs/webstore/*",
                "https://developer.chrome.com/docs/extensions",
                "https://developer.chrome.com/docs/extensions/",
                "https://instagram.com/reels/*",
                "https://chatgpt.com/"
            ]
        }
    ],
    "permissions": ["activeTab"]
}